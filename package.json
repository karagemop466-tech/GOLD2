{
  "name": "gold-evidence-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Source-first gold engagement ring research. No invented prices.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "security": "node scripts/security.mjs && npm audit --audit-level=low",
    "check:links": "node scripts/check-links.mjs",
    "test:browser": "node scripts/browser-tests.mjs",
    "check": "npm run verify && npm test && npm run build && npm run check:links && npm run security && npm run test:browser",
    "dev": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@sparticuz/chromium": "153.0.0"
  }
}
